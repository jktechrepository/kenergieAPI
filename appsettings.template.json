{
  "ConnectionStrings": {
    "KenergieConnection": "Server=localhost;Port=3306;Database=dev-kenergie;User=YOUR_USER;Password=YOUR_PASSWORD;CharSet=utf8mb4;"
  },
  "Jwt": {
    "SecretKey": "CHANGE_ME_MIN_32_CHARS_SECRET_KEY",
    "Issuer": "KenergieAPI",
    "Audience": "KenergieClient",
    "ExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 30
  },
  "Firebase": {
    "ProjectId": "your-firebase-project-id",
    "SenderId": "your-sender-id",
    "ApiKey": "your-firebase-api-key",
    "ServiceAccountEmail": "firebase-adminsdk@your-project.iam.gserviceaccount.com",
    "CredentialsPath": "firebase-credentials.json"
  },
  "Twilio": {
    "AccountSid": "your-twilio-account-sid",
    "AuthToken": "your-twilio-auth-token",
    "PhoneNumber": "+10000000000",
    "SenderId": "your-twilio-sender-id",
    "PrixParSms": 0.0467,
    "Enabled": false
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "Port": 587,
    "SenderEmail": "noreply@example.com",
    "Password": "your-smtp-password",
    "SenderName": "Kenergie Platform"
  },
  "FrontendSettings": {
    "BaseUrl": "https://your-frontend.example.com",
    "FacturePath": "/factures"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MySQL"
    ],
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Error",
        "Microsoft.AspNetCore": "Error",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/errors-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "restrictedToMinimumLevel": "Error",
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "MySQL",
        "Args": {
          "connectionString": "Server=localhost;Port=3306;Database=dev-kenergie;User=YOUR_USER;Password=YOUR_PASSWORD;CharSet=utf8mb4;",
          "tableName": "Logs",
          "autoCreateTable": true,
          "restrictedToMinimumLevel": "Error",
          "retentionPeriod": "7.00:00:00"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId",
      "WithEnvironmentName"
    ],
    "Properties": {
      "Application": "KenergieAPI",
      "Environment": "Development"
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Error",
      "Microsoft.EntityFrameworkCore": "Error",
      "Swashbuckle": "Error"
    }
  },
  "IpRateLimiting": {
    "EnableEndpointRateLimiting": true,
    "StackBlockedRequests": false,
    "RealIpHeader": "X-Real-IP",
    "ClientIdHeader": "X-ClientId",
    "HttpStatusCode": 429,
    "IpWhitelist": [
      "127.0.0.1",
      "::1"
    ],
    "EndpointWhitelist": [
      "get:/api/health",
      "get:/swagger/*"
    ],
    "ClientWhitelist": [],
    "QuotaExceededMessage": "Limite de requêtes dépassée. Réessayez dans {0}.",
    "GeneralRules": [
      {
        "Endpoint": "*",
        "Period": "1s",
        "Limit": 10
      },
      {
        "Endpoint": "*",
        "Period": "1m",
        "Limit": 100
      },
      {
        "Endpoint": "*",
        "Period": "1h",
        "Limit": 1000
      },
      {
        "Endpoint": "*",
        "Period": "1d",
        "Limit": 5000
      }
    ],
    "EndpointRules": [
      {
        "Endpoint": "POST:/api/Utilisateur/authentifier",
        "Period": "5m",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/Utilisateur/authentifier",
        "Period": "1h",
        "Limit": 20
      },
      {
        "Endpoint": "POST:/api/Utilisateur/reinitialiser-mot-de-passe",
        "Period": "1h",
        "Limit": 3
      },
      {
        "Endpoint": "POST:/api/Utilisateur/reinitialiser-mot-de-passe",
        "Period": "1d",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/Agent/batch",
        "Period": "1h",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/Paiement/batch",
        "Period": "1h",
        "Limit": 20
      },
      {
        "Endpoint": "POST:/api/Paiement",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/Paiement",
        "Period": "1h",
        "Limit": 100
      },
      {
        "Endpoint": "POST:/api/Inscription",
        "Period": "1m",
        "Limit": 10
      },
      {
        "Endpoint": "POST:/api/Inscription",
        "Period": "1h",
        "Limit": 50
      },
      {
        "Endpoint": "GET:/api/Eleve",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "GET:/api/Paiement",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "GET:/api/Note",
        "Period": "1m",
        "Limit": 30
      },
      {
        "Endpoint": "GET:/api/Presence",
        "Period": "1m",
        "Limit": 30
      }
    ]
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:5173",
      "http://localhost:5173"
    ]
  },
  "AWS": {
    "S3": {
      "BucketName": "your-bucket-name",
      "Region": "eu-north-1",
      "AccessKeyId": "YOUR_AWS_ACCESS_KEY_ID",
      "SecretAccessKey": "YOUR_AWS_SECRET_ACCESS_KEY"
    }
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:7110"
      }
    }
  }
}
